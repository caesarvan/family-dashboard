FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
 && apt-get install --no-install-recommends -y ffmpeg=7:7.1.5-0+deb13u1 \
 && rm -rf /var/lib/apt/lists/* \
 && python -m pip install --no-cache-dir pillow==12.3.0 \
 && useradd --no-create-home --uid 10001 decoder \
 && mkdir /decoder /decoder-private /decode-temp \
 && chown 10001:10001 /decoder-private /decode-temp \
 && chmod 0700 /decoder-private /decode-temp
WORKDIR /decoder
COPY media_video_service.py media_video_transport.py media_videos.py media_images.py ./
USER 10001:10001
ENTRYPOINT ["python", "-B", "/decoder/media_video_service.py"]
CMD ["--socket", "/decoder-private/video.sock", "--temp-root", "/decode-temp", "--ffmpeg", "/usr/bin/ffmpeg", "--ffprobe", "/usr/bin/ffprobe"]
